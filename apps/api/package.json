{
  "name": "@jt/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/scripts/seed.ts",
    "user:create": "tsx --env-file-if-exists=../../.env src/scripts/create-user.ts",
    "user:password": "tsx --env-file-if-exists=../../.env src/scripts/set-password.ts",
    "demo:seed": "tsx --env-file-if-exists=../../.env src/scripts/demo-seed.ts",
    "user:role": "tsx --env-file-if-exists=../../.env src/scripts/set-role.ts",
    "email:dry-run": "tsx --env-file-if-exists=../../.env src/scripts/email-dry-run.ts",
    "import:xlsx": "tsx --env-file-if-exists=../../.env src/scripts/import-xlsx.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@jt/shared": "workspace:*",
    "@node-rs/argon2": "^2.2.1",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "imapflow": "^2.2.6",
    "mailparser": "^3.9.36",
    "mammoth": "^1.13.0",
    "nodemailer": "^7.0.13",
    "pg": "^8.23.1",
    "pg-boss": "^12.37.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/mailparser": "^3.9.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "jszip": "^3.10.2",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15"
  }
}
