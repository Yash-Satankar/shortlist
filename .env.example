# Copy to .env and fill in. Never commit .env.
# Every variable the server reads is listed here (a test enforces it). The value shown is the
# default the app uses when the variable is unset; commented-out lines are off unless you set them.
#
# REQUIRED to run (the server refuses to start without them):
#   DATABASE_URL, ENCRYPTION_KEYS, ENCRYPTION_ACTIVE_KEY_ID
# REQUIRED for a real deployment:
#   NODE_ENV=production, APP_ORIGIN=https://your.domain, SERVE_WEB=true, TRUST_PROXY (behind a proxy)
# Everything else is optional: features you don't configure are simply off (the startup log says why).

# ---- Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Public origin shared by web + API. Dev: the Vite server. Prod: your Railway URL.
APP_ORIGIN=http://localhost:5173
# Reverse proxies in front of the app. Railway: 2 (edge hop + internal proxy; the edge
# replaces any client-sent X-Forwarded-For / X-Real-IP). Local: 0.
# Check with GET /api/health/request: ip must be your public IP and protocol "https".
TRUST_PROXY=0
# Production: Express serves apps/web/dist so web and API share one origin.
SERVE_WEB=false
# WEB_DIST_DIR=/app/apps/web/dist

# ---- Database (docker compose maps Postgres to 5433)
DATABASE_URL=postgres://jobtracker:jobtracker@localhost:5433/jobtracker
DATABASE_URL_TEST=postgres://jobtracker:jobtracker@localhost:5433/jobtracker_test
DATABASE_POOL_MAX=10

# ---- Field encryption (AES-256-GCM). Generate a key with: pnpm keygen
# Production must use its own key (never the dev key). Losing it makes encrypted fields
# (CTC, recruiter contacts) unreadable, so keep it in a password manager.
# Format: keyId:base64Key[,keyId:base64Key]. To rotate: add a new key, switch the active id.
ENCRYPTION_KEYS=k1:REPLACE_WITH_32_BYTE_BASE64_KEY
ENCRYPTION_ACTIVE_KEY_ID=k1

# ---- Auth
# Sliding sessions: each use extends the expiry to SESSION_TTL_DAYS from now; revocable in Settings.
# No session-signing secret exists: cookies hold random 256-bit tokens stored only as SHA-256 hashes.
SESSION_TTL_DAYS=30
SESSION_COOKIE_NAME=jt_sid
LOGIN_RATE_LIMIT_PER_15MIN=10
# Who can create an account:
#   closed  only the first-run setup screen (when the server has no accounts) or `pnpm user:create`
#   invite  an admin creates one-time invite links in Settings → Invites
#   open    anyone; needs email sending below (to confirm addresses), otherwise it acts as invite
SIGNUP_MODE=closed
# DEPRECATED: ALLOW_SIGNUP=true means SIGNUP_MODE=open
# ALLOW_SIGNUP=false
INVITE_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=60
EMAIL_VERIFY_TTL_HOURS=48
# Per-user writes per minute to the expensive endpoints (AI, import, resume upload, mailbox check)
RATE_LIMIT_EXPENSIVE_PER_MIN=20

# ---- Email sending (optional): address verification and "Forgot password". Any SMTP provider
# (Postmark, SES, Resend, Mailgun, Gmail with an app password). Off unless SMTP_HOST and MAIL_FROM are set.
# SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true = TLS from the start (usually port 465); false = STARTTLS when offered (587)
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=Job Tracker <no-reply@example.com>

# ---- Seed account (used by `pnpm db:seed`; development only, refuses NODE_ENV=production)
SEED_USER_EMAIL=you@example.com
SEED_USER_PASSWORD=change-me-please
SEED_USER_NAME=Your Name

# ---- Tracker behaviour defaults (each user can override in settings)
GHOST_AFTER_DAYS=21
# After "Not yet" on a ghost suggestion, suggest again after this many days (sooner on new activity)
GHOST_SUGGEST_DAYS=7
FOLLOW_UP_AFTER_DAYS=10
# Interview with no update for this many days → "post-interview check-in" follow-up
POST_INTERVIEW_FOLLOW_UP_DAYS=5
# Automatic signals scoring at/above this (0–1) count as "high" confidence
CONFIDENCE_HIGH_THRESHOLD=0.8
# Extension "application submitted" detection: score for detectors verified on real pages, and for
# those not verified yet (below the threshold → it waits in Follow-ups for you to confirm)
DETECTION_VERIFIED_CONFIDENCE=0.95
DETECTION_UNVERIFIED_CONFIDENCE=0.4
# Portal sync: days the encrypted snapshot of a read applications list is kept, and the score of a
# change you accepted in review (at/above CONFIDENCE_HIGH_THRESHOLD → it applies)
PORTAL_SNAPSHOT_RETENTION_DAYS=90
PORTAL_CONFIRMED_CONFIDENCE=0.9
DEFAULT_TIMEZONE=Asia/Kolkata

# Server errors kept for Settings → Recent errors (admins), in days
ERROR_LOG_RETENTION_DAYS=30

# ---- Background jobs (pg-boss queue in this database, schema "pgboss"; created on first start)
JOBS_ENABLED=true
# Daily clean-up (cron): expired portal snapshots and AI cache
JOB_PURGE_CRON=17 3 * * *

# ---- Features (instance layer). What this deployment offers; each user can switch them off
# for themselves in Settings → Features. The API logs which are on, and why others are off, at start.
# AI is bring-your-own-key: AI features stay off for a user until they add an API key.
FEATURE_AI=true
# Email updates from your mailbox. Offered only when the chosen mode below is fully configured
# (the startup log says what's missing).
FEATURE_EMAIL_INTAKE=false
# imap (one mailbox, self-hosting) | inbound (per-user forwarding address via a webhook provider)
EMAIL_INTAKE_MODE=imap
FEATURE_EXTENSION=true
# Needs FEATURE_EXTENSION
FEATURE_PORTAL_SYNC=true
# These three need FEATURE_AI
FEATURE_PREP=true
FEATURE_CHAT=true
FEATURE_FOLLOWUP_DRAFTS=true

# ---- AI (bring your own key). Users add their own keys in Settings → AI; nothing here is required.
# Optional instance keys, for self-hosters. They serve ADMIN accounts only (the first account is admin).
# Leave them unset on a public instance.
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# TOGETHER_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=https://your-endpoint.example/v1
# OPENAI_COMPATIBLE_API_KEY=
# Default monthly spend cap per user, in DEFAULT_CURRENCY (each user can change theirs)
LLM_MONTHLY_CAP_DEFAULT=500
DEFAULT_CURRENCY=INR
# Units of DEFAULT_CURRENCY per US dollar, for cost estimates (users can change theirs)
DEFAULT_USD_RATE=88
LLM_CACHE_TTL_DAYS=30
LLM_TIMEOUT_MS=60000
# Longest text sent to a model in one call; longer input is refused rather than cut
LLM_MAX_INPUT_CHARS=40000
LLM_RATE_LIMIT_PER_MIN=20
# Allow OpenAI-compatible base URLs on private/LAN addresses (e.g. a local model server).
# Self-hosting only: with sign-up open this would let users reach your private network.
LLM_ALLOW_PRIVATE_BASE_URLS=false
# Extra or overriding prices, USD per 1M tokens, for models not in the built-in list
# LLM_PRICES_JSON={"my-model": [0.5, 1.5]}
# Default model per provider/task when the user hasn't picked one (over the built-in defaults:
# Groq openai/gpt-oss-20b for page reading and email sorting, gpt-oss-120b for writing;
# Together Llama 3.3 70B Turbo; Anthropic Haiku 4.5 / Opus 5.5)
# LLM_DEFAULT_MODELS_JSON={"groq": {"extraction": "openai/gpt-oss-20b"}}
# Provider order per task when the user has several keys (built-in: page reading and email
# sorting prefer Groq; prep packs and chat prefer Anthropic, then Together, then Groq)
# LLM_TASK_PROVIDERS_JSON={"prep": ["together", "anthropic", "groq"]}
# Reasoning models (regex on the model id) get this effort, plus extra token room for their thinking
LLM_REASONING_MODELS=^openai/gpt-oss
LLM_REASONING_EFFORT=low
LLM_REASONING_HEADROOM_TOKENS=1024

# ---- Ask my job search, prep packs, follow-up drafts (all use the user's own AI key)
# Include stored job emails in Ask for users who haven't chosen (their switch in Settings wins).
# Email excerpts are decrypted in memory for that one question and sent to the user's AI provider.
ASK_INCLUDE_EMAILS_DEFAULT=false
ASK_MAX_SOURCES=12
ASK_SNIPPET_CHARS=700
ASK_MAX_EMAILS_SCANNED=500
ASK_MAX_QUESTION_CHARS=500
ASK_MAX_LIST_ROWS=50
ASK_ANSWER_MAX_TOKENS=700
PREP_MAX_OUTPUT_TOKENS=3000
PREP_MAX_JD_CHARS=12000
PREP_MAX_RESUME_CHARS=8000
PREP_MAX_ANSWERS=30
DRAFT_MAX_OUTPUT_TOKENS=900
# LinkedIn's connection-note limit (enforced on every note draft)
LINKEDIN_NOTE_MAX_CHARS=300

# ---- Extension build (read when building the extension, not by the server)
# VITE_JD_MIN_CHARS=600        shortest text accepted as a job description
# VITE_JD_SETTLE_MAX_MS=4000   how long to re-check a page whose description renders late
# VITE_JD_SETTLE_IDLE_MS=400

# ---- Email intake: imap mode (self-hosting: one mailbox per instance, read-only)
# Gmail: turn on 2-step verification, create an App password (Google Account → Security → App
# passwords) and use it here, never your main password. Messages are never marked as read.
# IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
# IMAP_USER=you@gmail.com
# IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
# Which account the mailbox belongs to (default: the first admin)
# IMAP_OWNER_EMAIL=
# First run reads this many days back; later runs continue from where they stopped
IMAP_SINCE_DAYS=30
IMAP_MAX_PER_RUN=200
EMAIL_POLL_CRON=*/5 * * * *
# Runs never overlap (a lease on the mailbox); a crashed run's lease expires after this long
EMAIL_POLL_LOCK_MINUTES=15
# Settings and Follow-ups flag the mailbox after this many failed checks in a row…
EMAIL_POLL_ALERT_FAILURES=3
# …or when nothing was read successfully for this long (e.g. the scheduler stopped)
EMAIL_POLL_STALE_MINUTES=60

# ---- Email intake: inbound mode (hosted: per-user forwarding addresses via Postmark)
# Point the domain's MX at Postmark inbound and set the webhook URL to
# https://<INBOUND_WEBHOOK_USER>:<INBOUND_WEBHOOK_PASSWORD>@<your app>/api/email/inbound/postmark
# INBOUND_EMAIL_DOMAIN=in.example.com
# INBOUND_WEBHOOK_USER=postmark
# INBOUND_WEBHOOK_PASSWORD=  (12+ characters)

# ---- Stored emails (only job-related ones; sender, subject and excerpt encrypted)
EMAIL_RETENTION_DAYS=90
EMAIL_EXCERPT_CHARS=4000
# Highest confidence for an email matched by company alone (below the threshold → you review it)
EMAIL_COMPANY_MATCH_CONFIDENCE=0.6
# A notice the rules understood, from a known job portal / ATS, matched by the job's own link
# (at/above CONFIDENCE_HIGH_THRESHOLD → forward moves like "viewed" apply, undoable)
EMAIL_ATS_LINK_MATCH_CONFIDENCE=0.92
# Highest score the AI fallback can give an email
EMAIL_AI_MAX_CONFIDENCE=0.85
# Override the rules' own scores per category
# EMAIL_RULE_CONFIDENCE_JSON={"received": 0.88, "viewed": 0.75, "assessment": 0.82, "interview": 0.8, "rejected": 0.92, "offer": 0.7}
