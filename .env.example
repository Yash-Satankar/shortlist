# Copy to .env and fill in. Never commit .env.
# Every tunable lives here; defaults shown are what the app uses if a var is unset.

# ---- Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Public origin shared by web + API. Dev: the Vite server. Prod: your Railway URL.
APP_ORIGIN=http://localhost:5173
# Reverse proxies in front of the app. Railway: 2 (edge hop + internal proxy; the edge
# replaces any client-sent X-Forwarded-For / X-Real-IP). Local: 0.
# Check with GET /api/health/request: ip must be your public IP and protocol "https".
TRUST_PROXY=0
# Production: Express serves apps/web/dist so web and API share one origin.
SERVE_WEB=false
# WEB_DIST_DIR=/app/apps/web/dist

# ---- Database (docker compose maps Postgres to 5433)
DATABASE_URL=postgres://jobtracker:jobtracker@localhost:5433/jobtracker
DATABASE_URL_TEST=postgres://jobtracker:jobtracker@localhost:5433/jobtracker_test
DATABASE_POOL_MAX=10

# ---- Field encryption (AES-256-GCM). Generate a key with: pnpm keygen
# Production must use its own key (never the dev key). Losing it makes encrypted fields
# (CTC, recruiter contacts) unreadable, so keep it in a password manager.
# Format: keyId:base64Key[,keyId:base64Key]. To rotate: add a new key, switch the active id.
ENCRYPTION_KEYS=k1:REPLACE_WITH_32_BYTE_BASE64_KEY
ENCRYPTION_ACTIVE_KEY_ID=k1

# ---- Auth
# Sliding sessions: each use extends the expiry to SESSION_TTL_DAYS from now; revocable in Settings.
# No session-signing secret exists: cookies hold random 256-bit tokens stored only as SHA-256 hashes.
SESSION_TTL_DAYS=30
SESSION_COOKIE_NAME=jt_sid
ALLOW_SIGNUP=false
LOGIN_RATE_LIMIT_PER_15MIN=10

# ---- Seed account (used by `pnpm db:seed`; development only, refuses NODE_ENV=production)
SEED_USER_EMAIL=you@example.com
SEED_USER_PASSWORD=change-me-please
SEED_USER_NAME=Your Name

# ---- Tracker behaviour defaults (each user can override in settings)
GHOST_AFTER_DAYS=21
# After "Not yet" on a ghost suggestion, suggest again after this many days (sooner on new activity)
GHOST_SUGGEST_DAYS=7
FOLLOW_UP_AFTER_DAYS=10
# Interview with no update for this many days → "post-interview check-in" follow-up
POST_INTERVIEW_FOLLOW_UP_DAYS=5
# Automatic signals scoring at/above this (0–1) count as "high" confidence
CONFIDENCE_HIGH_THRESHOLD=0.8
# Extension "application submitted" detection: score for detectors verified on real pages, and for
# those not verified yet (below the threshold → it waits in Follow-ups for you to confirm)
DETECTION_VERIFIED_CONFIDENCE=0.95
DETECTION_UNVERIFIED_CONFIDENCE=0.4
# Portal sync: days the encrypted snapshot of a read applications list is kept, and the score of a
# change you accepted in review (at/above CONFIDENCE_HIGH_THRESHOLD → it applies)
PORTAL_SNAPSHOT_RETENTION_DAYS=90
PORTAL_CONFIRMED_CONFIDENCE=0.9
DEFAULT_TIMEZONE=Asia/Kolkata

# ---- Features (instance layer). What this deployment offers; each user can switch them off
# for themselves in Settings → Features. The API logs which are on, and why others are off, at start.
# AI is bring-your-own-key: AI features stay off for a user until they add an API key.
FEATURE_AI=true
# Email intake isn't available yet (Phase 3); turning it on only logs why it's off.
FEATURE_EMAIL_INTAKE=false
# imap (one mailbox, self-hosting) | inbound (per-user forwarding address via a webhook provider)
EMAIL_INTAKE_MODE=imap
FEATURE_EXTENSION=true
# Needs FEATURE_EXTENSION
FEATURE_PORTAL_SYNC=true
# These three need FEATURE_AI
FEATURE_PREP=true
FEATURE_CHAT=true
FEATURE_FOLLOWUP_DRAFTS=true

# ---- AI (bring your own key). Users add their own keys in Settings → AI; nothing here is required.
# Optional instance keys, for self-hosters. They serve ADMIN accounts only (the first account is admin).
# Leave them unset on a public instance.
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# TOGETHER_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=https://your-endpoint.example/v1
# OPENAI_COMPATIBLE_API_KEY=
# Default monthly spend cap per user, in DEFAULT_CURRENCY (each user can change theirs)
LLM_MONTHLY_CAP_DEFAULT=500
DEFAULT_CURRENCY=INR
# Units of DEFAULT_CURRENCY per US dollar, for cost estimates (users can change theirs)
DEFAULT_USD_RATE=88
LLM_CACHE_TTL_DAYS=30
LLM_TIMEOUT_MS=60000
# Longest text sent to a model in one call; longer input is refused rather than cut
LLM_MAX_INPUT_CHARS=40000
LLM_RATE_LIMIT_PER_MIN=20
# Allow OpenAI-compatible base URLs on private/LAN addresses (e.g. a local model server).
# Self-hosting only: with sign-up open this would let users reach your private network.
LLM_ALLOW_PRIVATE_BASE_URLS=false
# Extra or overriding prices, USD per 1M tokens, for models not in the built-in list
# LLM_PRICES_JSON={"my-model": [0.5, 1.5]}

# ---- Extension build (read when building the extension, not by the server)
# VITE_JD_MIN_CHARS=600        shortest text accepted as a job description
# VITE_JD_SETTLE_MAX_MS=4000   how long to re-check a page whose description renders late
# VITE_JD_SETTLE_IDLE_MS=400

# ---- Later phases (not read yet; listed so the shape is known)
# IMAP_HOST=imap.gmail.com  IMAP_PORT=993  IMAP_USER=  IMAP_PASSWORD=  IMAP_POLL_INTERVAL_SECONDS=300
